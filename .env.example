
# Application
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Frontend URL (Vite)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database
# Replace the placeholder values with your local configuration.
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/tpo_placement_db?schema=public"

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Password Hashing
BCRYPT_SALT_ROUNDS=12
