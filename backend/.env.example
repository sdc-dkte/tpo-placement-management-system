
# Application (Port 5001 avoids macOS AirPlay port 5000 conflict)
PORT=5001
HOST=0.0.0.0
NODE_ENV=development

# Frontend URL (Vite dev server)
CLIENT_URL=http://localhost:3000

# PostgreSQL Database
# Replace username & password with your local PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tpo_placement_db?schema=public"

# JWT Authentication
JWT_SECRET=dkte_tpo_jwt_secret_key_super_secure_2026_placement_season
JWT_EXPIRES_IN=1d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# Initial TPO Account Seed (Optional - defaults to tpo@dkte.ac.in / Admin@1234)
TPO_NAME="TPO Administrator"
TPO_EMAIL="tpo@dkte.ac.in"
TPO_PASSWORD="Admin@1234"

